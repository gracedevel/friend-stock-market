rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /market/{docId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && docId == 'state'
        && request.resource.data.maxMembers == 10
        && request.resource.data.memberCount is int
        && request.resource.data.memberCount >= 0
        && request.resource.data.memberCount <= 10
        && request.resource.data.memberCount == resource.data.memberCount + 1;
      allow delete: if false;
    }
    match /stocks/{stockId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /profiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.active == true
        && request.resource.data.credits == 1000
        && request.resource.data.holdings is map
        && request.resource.data.usernameLower is string
        && request.resource.data.usernameLower.matches('^[a-z0-9_]{3,20}$');
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.usernameLower == resource.data.usernameLower
        && request.resource.data.username == resource.data.username
        && request.resource.data.credits >= 0
        && request.resource.data.credits <= 100000000
        && request.resource.data.holdings is map;
      allow delete: if false;
    }
    match /trades/{tradeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0;
      allow update, delete: if false;
    }
  }
}
